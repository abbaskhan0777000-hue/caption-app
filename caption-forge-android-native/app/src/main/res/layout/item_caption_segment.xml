<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp">

    <!-- Timestamp Pill & Trash Icon Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTimeRange"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_white_button"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="0:00.620 - 0:00.970"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Delete Segment Button -->
        <ImageView
            android:id="@+id/btnDeleteSegment"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:src="@drawable/ic_trash_red" />
    </LinearLayout>

    <!-- Text Input Box -->
    <EditText
        android:id="@+id/etSegmentText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_segment_input"
        android:fontFamily="sans-serif-medium"
        android:gravity="top|start"
        android:hint="Caption phrase..."
        android:inputType="textMultiLine"
        android:minLines="2"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <!-- "+ Add a line" Divider -->
    <LinearLayout
        android:id="@+id/btnAddLineDivider"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="@color/border_subtle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:text="+ Add a line"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="@color/border_subtle" />
    </LinearLayout>

</LinearLayout>
