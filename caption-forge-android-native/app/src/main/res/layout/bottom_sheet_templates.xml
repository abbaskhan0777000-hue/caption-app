<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_white_button"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_dark_pill"
        android:backgroundTint="@color/border_focused" />

    <!-- Title & Subtitle (Screenshots 1-5) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="Templates"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Browse our preset templates to elevate your content"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Horizontal Category Chips Bar (Screenshots 1-5) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- 1. Legacy -->
            <TextView
                android:id="@+id/chipCatLegacy"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_dark_pill"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Legacy"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- 2. Modern -->
            <TextView
                android:id="@+id/chipCatModern"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_white_button"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Modern"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- 3. Viral -->
            <TextView
                android:id="@+id/chipCatViral"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_white_button"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Viral"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- 4. Bold -->
            <TextView
                android:id="@+id/chipCatBold"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_white_button"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Bold"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- 5. Minimal -->
            <TextView
                android:id="@+id/chipCatMinimal"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_white_button"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Minimal"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- 6. Cool -->
            <TextView
                android:id="@+id/chipCatCool"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_white_button"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Cool"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- 7. Split view -->
            <TextView
                android:id="@+id/chipCatSplitView"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_white_button"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Split view"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Vertical List for Full-Width Preset Template Cards (Screenshots 1-5) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTemplatesGrid"
        android:layout_width="match_parent"
        android:layout_height="310dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:scrollbars="none" />

    <!-- Bottom Actions: Cancel & Apply -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancelTemplates"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_white_button"
            android:gravity="center"
            android:text="Cancel"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnApplyTemplates"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dark_pill"
            android:gravity="center"
            android:text="Apply"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
