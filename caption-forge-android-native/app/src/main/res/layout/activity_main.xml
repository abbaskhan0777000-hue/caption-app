<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Top Action Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bg_surface"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CaptionForge"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@color/bg_surface_card"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="AI"
            android:textColor="@color/accent_yellow"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tvLogo"
            app:layout_constraintStart_toEndOf="@id/tvLogo"
            app:layout_constraintTop_toTopOf="@id/tvLogo" />

        <!-- Select Video Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelectVideo"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="10dp"
            android:text="Select Video"
            android:textColor="@color/text_slate_200"
            android:textSize="11sp"
            app:cornerRadius="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnSettings"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="@color/border_surface" />

        <!-- Settings Button -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:background="@color/bg_surface_light"
            android:src="@android:drawable/ic_menu_preferences"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnExport"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Export Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExport"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="@color/accent_green"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="12dp"
            android:text="Export"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Center Video & Draggable Caption Canvas -->
    <FrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#000000"
        app:layout_constraintBottom_toTopOf="@id/playerControls"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:surface_type="surface_view"
            app:use_controller="false" />

        <!-- Native Draggable/Pinchable Caption Overlay -->
        <com.captionforge.nativeapp.ui.CaptionOverlayView
            android:id="@+id/captionOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Empty State Prompt -->
        <LinearLayout
            android:id="@+id/layoutEmptyPrompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_gallery" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tap 'Select Video' to start"
                android:textColor="@color/text_slate_400"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Transcription Loading Overlay -->
        <LinearLayout
            android:id="@+id/layoutTranscribeLoading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/black_overlay"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/accent_yellow" />

            <TextView
                android:id="@+id/tvTranscribeStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Transcribing with Groq Whisper AI..."
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </FrameLayout>

    <!-- Player Controls (Seekbar + Play/Pause) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/playerControls"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/bg_surface"
        android:paddingHorizontal="12dp"
        app:layout_constraintBottom_toTopOf="@id/bottomToolContainer">

        <ImageButton
            android:id="@+id/btnPlayPause"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@color/transparent"
            android:src="@android:drawable/ic_media_play"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:progressTint="@color/accent_yellow"
            android:thumbTint="@color/accent_yellow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvTimeCode"
            app:layout_constraintStart_toEndOf="@id/btnPlayPause"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTimeCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="00:00 / 00:00"
            android:textColor="@color/text_slate_400"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Bottom InShot-Style Tool Panels Container -->
    <FrameLayout
        android:id="@+id/bottomToolContainer"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@color/bg_surface"
        app:layout_constraintBottom_toTopOf="@id/bottomTabBar">

        <!-- Panel 1: Presets -->
        <LinearLayout
            android:id="@+id/panelPresets"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="🔥 Trending Creator Styles"
                android:textColor="@color/accent_yellow"
                android:textSize="12sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPresets"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </LinearLayout>

        <!-- Panel 2: Font & Size -->
        <LinearLayout
            android:id="@+id/panelFontSize"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <!-- Numeric Size Control Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Font Size (Numeric)"
                    android:textColor="@color/text_white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSizeMinus"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="-"
                    android:textColor="@color/text_white"
                    android:textSize="16sp"
                    app:cornerRadius="6dp"
                    app:strokeColor="@color/border_surface" />

                <EditText
                    android:id="@+id/etFontSizeNumber"
                    android:layout_width="60dp"
                    android:layout_height="38dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@color/bg_surface_light"
                    android:gravity="center"
                    android:inputType="number"
                    android:text="65"
                    android:textColor="@color/accent_yellow"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSizePlus"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="+"
                    android:textColor="@color/text_white"
                    android:textSize="16sp"
                    app:cornerRadius="6dp"
                    app:strokeColor="@color/border_surface" />
            </LinearLayout>

            <!-- Quick Size Preset Chips -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/chipSize40"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:text="40"
                    android:textColor="@color/text_slate_200"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/chipSize65"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:text="65"
                    android:textColor="@color/text_slate_200"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/chipSize90"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:text="90"
                    android:textColor="@color/text_slate_200"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/chipSize120"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:text="120"
                    android:textColor="@color/text_slate_200"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/chipSize160"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:text="160"
                    android:textColor="@color/text_slate_200"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/chipSize200"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:text="200"
                    android:textColor="@color/accent_yellow"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Font Family Selector -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Select Font Family"
                android:textColor="@color/text_slate_400"
                android:textSize="11sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFonts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </LinearLayout>

        <!-- Panel 3: Colors & Effects -->
        <ScrollView
            android:id="@+id/panelColors"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="10dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active Word Highlight Color"
                    android:textColor="@color/text_white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvHighlightColors"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Text Color"
                    android:textColor="@color/text_white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTextColors"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
            </LinearLayout>
        </ScrollView>

        <!-- Panel 4: Transcript Editor -->
        <LinearLayout
            android:id="@+id/panelTranscript"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvTranscriptCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="📝 Word-by-Word Transcript (Tap to seek/edit)"
                android:textColor="@color/text_white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTranscript"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </LinearLayout>

    </FrameLayout>

    <!-- Bottom InShot Navigation Tab Bar -->
    <LinearLayout
        android:id="@+id/bottomTabBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/bg_dark"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/tabPresets"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🔥 Styles"
            android:textColor="@color/accent_yellow"
            android:textSize="11sp" />

        <Button
            android:id="@+id/tabFontSize"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🔤 Font"
            android:textColor="@color/text_slate_400"
            android:textSize="11sp" />

        <Button
            android:id="@+id/tabColors"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🎨 Color"
            android:textColor="@color/text_slate_400"
            android:textSize="11sp" />

        <Button
            android:id="@+id/tabTranscript"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="📝 Words"
            android:textColor="@color/text_slate_400"
            android:textSize="11sp" />

        <Button
            android:id="@+id/tabTranscribe"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="⚡ Auto AI"
            android:textColor="@color/primary_500"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
