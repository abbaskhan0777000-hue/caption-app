<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="140dp"
    android:layout_height="match_parent"
    android:layout_marginEnd="8dp"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="@color/bg_surface_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:id="@+id/layoutCardContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvPresetBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 #1 Viral"
            android:textColor="@color/accent_yellow"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPresetName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Hormozi Pop"
            android:textColor="@color/text_white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPresetPreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#000000"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="VIRAL POP"
            android:textColor="@color/accent_yellow"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.cardview.widget.CardView>
